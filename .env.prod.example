# Copied to `.env` on the LXC (compose interpolation) and rewritten by the
# deploy workflow from GitHub Actions secrets. Never commit the real file.
#
# DATABASE_URL must use the Docker DNS hostname `db`, not localhost.
DATABASE_URL=postgresql://reloading:reloading@db:5432/reloading

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels).
TUNNEL_TOKEN=

# Self-hosted runner registration. Token is short-lived (~1h) and only needed
# the first time the github-runner container starts (when `.runner` is absent).
ACTIONS_RUNNER_REPO_URL=https://github.com/KennethEgholm/reloading
ACTIONS_RUNNER_TOKEN=
RUNNER_NAME=reloading-runner
