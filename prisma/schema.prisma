// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is provided via prisma.config.ts (Prisma 7+ requirement)
}

enum PrimerType {
  SMALL_RIFLE
  LARGE_RIFLE
  SMALL_PISTOL
  LARGE_PISTOL
}

// Singleton row holding AI model configuration (always id = "singleton").
// Provider is switchable; "grok" (xAI) is the first supported provider.
model AiSettings {
  id          String   @id @default("singleton")
  provider    String   @default("grok")
  apiKey      String? // bearer token (stored plaintext; app has no auth)
  model       String? // e.g. "grok-3", "grok-2-latest"
  baseUrl     String? // e.g. "https://api.x.ai/v1"
  temperature Float? // optional call param
  maxTokens   Int? // optional call param
  updatedAt   DateTime @updatedAt
}

model Propellant {
  id          String   @id @default(cuid())
  brand       String
  type        String
  amountGr    Float // Stock in grams (user preference)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipes Recipe[]
}

model Projectile {
  id          String   @id @default(cuid())
  brand       String
  type        String? // e.g. "Game King", "MatchKing", "Tipped"
  weightGr    Float // Weight in grains (industry standard)
  caliber     String
  amount      Int      @default(0) // Number of projectiles in stock
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipes Recipe[]
}

model Primer {
  id          String     @id @default(cuid())
  brand       String
  magnum      Boolean    @default(false)
  type        PrimerType
  amount      Int // Count of individual primers
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  recipes Recipe[]
}

model Cartridge {
  id              String   @id @default(cuid())
  brand           String // Brand / name (e.g. "Lapua", "Starline")
  caliber         String
  waterCapacityGr Float? // Case water capacity in grains of water (optional)
  amount          Int      @default(0) // Number of cases in stock
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipes Recipe[]
}

model Recipe {
  id           String   @id @default(cuid())
  name         String
  caliber      String
  projectileId String
  propellantId String
  primerId     String?
  cartridgeId  String?
  chargeGr     Float? // Powder charge in grains
  coal         Float? // Cartridge Overall Length (inches)
  calculatedV0 Float? // Calculated muzzle velocity (m/s)
  measuredV0   Float? // Measured muzzle velocity (m/s)
  fillRate     Float? // Powder fill rate (%)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Latest AI safety-check assessment (advisory only). Nullable until run.
  aiVerdict   String? // "OK" | "CAUTION" | "STOP" | "UNKNOWN"
  aiSummary   String? // short prose summary
  aiConcerns  String? // JSON array of concern strings (stored as text)
  aiModel     String? // model used, for provenance
  aiCheckedAt DateTime? // when the check was last run

  projectile Projectile @relation(fields: [projectileId], references: [id])
  propellant Propellant @relation(fields: [propellantId], references: [id])
  primer     Primer?    @relation(fields: [primerId], references: [id])
  cartridge  Cartridge? @relation(fields: [cartridgeId], references: [id])
  loadLogs   LoadLog[]
  rangeLogs  RangeLog[]
}

model LoadLog {
  id       String   @id @default(cuid())
  date     DateTime @default(now())
  recipeId String? // Optional for historical integrity
  quantity Int
  notes    String?

  // Snapshot of recipe at time of loading (for historical accuracy)
  // These are optional because older log entries may not have this data.
  recipeName String?
  caliber    String?
  chargeGr   Float? // grains per cartridge at the time
  coal       Float? // cartridge overall length at the time

  // Projectile snapshot
  projectileBrand    String?
  projectileType     String?
  projectileWeightGr Float?

  // Propellant snapshot
  propellantBrand String?
  propellantType  String?

  // Primer snapshot (if used)
  primerBrand String?
  primerType  String?

  // Cartridge snapshot (if the recipe links a cartridge)
  cartridgeBrand           String?
  cartridgeCaliber         String?
  cartridgeWaterCapacityGr Float?

  // Optional recipe data captured at load time
  calculatedV0 Float?
  measuredV0   Float?
  fillRate     Float?

  // Component IDs at the time of loading (used for inventory restoration when deleting a log)
  projectileId String?
  propellantId String?
  primerId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
}

model RangeLog {
  id            String   @id @default(cuid())
  date          DateTime
  location      String?
  conditions    String?
  recipeId      String? // Nullable: a recipe deletion nulls the FK; the snapshot below preserves the record
  roundsFired   Int
  velocityMin   Float?
  velocityMax   Float?
  velocityAvg   Float?
  extremeSpread Float?
  stdDev        Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Snapshot of the recipe at the time the session was logged, frozen for
  // historical accuracy. Survives recipe edits and deletion. Mirrors LoadLog.
  recipeName         String?
  caliber            String?
  chargeGr           Float?
  coal               Float?
  projectileBrand    String?
  projectileType     String?
  projectileWeightGr Float?
  propellantBrand    String?
  propellantType     String?
  primerBrand        String?
  primerType         String?
  calculatedV0       Float?
  measuredV0         Float?
  fillRate           Float?

  recipe        Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  images        RangeLogImage[]   @relation("RangeLogImages")
  mainImageId   String?  @unique
  mainImage     RangeLogImage?    @relation("MainImage", fields: [mainImageId], references: [id], onDelete: SetNull)
}

model RangeLogImage {
  id          String   @id @default(cuid())
  rangeLogId  String
  filename    String
  description String?
  createdAt   DateTime @default(now())

  rangeLog    RangeLog @relation("RangeLogImages", fields: [rangeLogId], references: [id], onDelete: Cascade)
  mainForLog  RangeLog? @relation("MainImage")
}
